{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex-agent/schemas/event-bus/subagent_spawned.json",
  "title": "subagent_spawned payload",
  "type": "object",
  "required": ["subagent_role", "task_description"],
  "additionalProperties": true,
  "properties": {
    "subagent_role":             { "type": "string" },
    "task_description":          { "type": "string" },
    "tools_granted":             { "type": "array", "items": { "type": "string" } },
    "model":                     { "type": "string" },
    "expected_duration_minutes": { "type": "integer", "minimum": 0 }
  }
}
