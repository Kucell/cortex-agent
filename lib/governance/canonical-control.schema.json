{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortex-agent:canonical-control-records:1",
  "title": "Unactivated canonical control records v1",
  "description": "New backend-bound canonical identity, Owner, replay and audit records. No runtime permit. Schema adoption and bootstrap require independent approval. Legacy records never gain new authority by migration.",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "project_id"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        }
      },
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "identity_ref",
        "identity_digest",
        "subject",
        "backend",
        "bootstrap",
        "status",
        "generation",
        "supersedes",
        "role",
        "execution_authorized"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "project-owner-binding"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "identity_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        },
        "identity_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 71,
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "subject": {
          "type": "object",
          "required": [
            "provider",
            "account_id"
          ],
          "properties": {
            "provider": {
              "const": "github"
            },
            "account_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "required": [
            "kind",
            "repository_id",
            "repository",
            "authority_ref"
          ],
          "properties": {
            "kind": {
              "const": "github-ref"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "repository": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140,
              "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"
            },
            "authority_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^refs/heads/cortex-authority/[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
            }
          },
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "object",
          "required": [
            "manifest_digest",
            "source_audit_ref"
          ],
          "properties": {
            "manifest_digest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 71,
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "source_audit_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        },
        "role": {
          "const": "project_approver"
        },
        "execution_authorized": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "identity_ref",
        "identity_digest",
