{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex-agent.local/schemas/advisory-plan.schema.json",
  "title": "Committed advisory plan; no execution authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "project_id",
    "task_id",
    "mission_id",
    "task_source",
    "mission_contract",
    "scope",
    "risk_tier",
    "validation_commands",
    "estimated_budget",
    "required_host_capabilities",
    "stop_conditions",
    "created_at",
    "expires_at",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^AP-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^M-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "mission_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "product_commit",
        "allowed_paths",
        "allowed_operations"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allowed_operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
          }
        }
      }
    },
    "risk_tier": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "estimated_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "cost_amount",
        "currency"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "cost_amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "required_host_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._:-]{0,95}$"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "owner_workflow",
        "decision_id",
        "waitpoint_id"
      ],
      "properties": {
        "action": {
          "const": "external_side_effect"
        },
        "owner_workflow": {
          "const": "/mission"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^D-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        },
        "waitpoint_id": {
          "type": "string",
          "pattern": "^WP-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
        }
      }
    },
    "task_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "git_blob"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
