# Active symlink generated by linkGlobalConfig() — must not be committed.
# (Absolute targets break across users; relative targets still vary per machine.)
.agent/global

# Local secrets store (per-user, never commit). Internal .gitignore enforces
# the same rule; the top-level entry protects against future moves or symlinks.
# The directory itself may exist on a developer's machine (Penpot userToken,
# ad-hoc MCP credentials, etc.) — git must never see its contents.
/.agent/secrets/
/.agent/**/*.local.env
/.agent/**/secrets/

# Governed learning corpus (P-003 §5 invariant 5): local destination must be
# excluded from Git and team-pack. Never commit corpus records or manifests.
.agent-runtime/corpus/

# Pi coding-agent runtime / cache directories — local-only state, never commit.
.pi-glla/
.pi/
# cortex-agent linkGlobalConfig (2026-08-13T14:04:28.559Z)
# Active symlinks generated by linkGlobalConfig() — must not be committed.
# (Relative targets still vary per machine; absolute targets break across users.)
.cursor/global-rules


# Pilot audit reports (output of cortex-agent pilot corpus verification).
# Generated by the redacted-publish dogfood flow; safe to delete locally.
pilot-report.json

# Operator-only legacy migration overrides (M-LEGACY-MEM-001): not source
memory-legacy-overrides.json
