metrics/agent-dashboard.html
sessions/S-*.json
runtime-continuity/guard/

# Token usage ledger — raw runtime evidence is high-frequency local-only
# state; only the dated tar.gz archives under archives/ are committed.
token-attempts/receipts/
token-attempts/ledger-index.json
token-attempts/recovery-events.jsonl

# Graphify plugin runtime state. The shared implementation under
# plugins/graphify/lib/ IS framework-owned and tracked; the marker files
# beside it are local runtime state and must never enter the source tree.
plugins/graphify/.hook-installed
plugins/graphify/.hook-unwired.json

# Graphify edge-density guard runtime state (issue #154). The density
# baseline and the rebuild-cooldown marker are local runtime state: the
# baseline describes THIS checkout's graph and must not be shared between
# machines, and the cooldown marker is meaningless elsewhere.
plugins/graphify/.density-baseline.json
plugins/graphify/.density-rebuild-state.json

# The atomic-write temp files. Each writer uses an exclusive name
# (`.NAME.tmp-<pid>-<random>`) so concurrent writers cannot publish each
# other's half-written file; they exist only for the duration of the write.
plugins/graphify/.*.tmp-*

# The rebuild lock is a transient, machine-local mutex. It exists only while a
# rebuild is running, so it must never be shared between machines.
plugins/graphify/.density-rebuild.lock

# The pending-update queue. It records an incremental update that had to
# wait for the rebuild lock; it is local runtime state.
plugins/graphify/.density-pending/

# Graphify detached full-rebuild logs. The runtime-artifact convention puts
# every artifact under .agent/, never in the temp directory; the logs are
# local-only and must not enter the source tree.
logs/graphify/
