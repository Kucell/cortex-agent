{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex-agent.dev/schemas/evolution-task.schema.json",
  "title": "Evolution Task",
  "description": "Evolution queue record. Archive learning proposals are explicitly opted in, immutable, project/workspace scoped, and never grant memory or execution effects. Legacy task processing remains a separate workflow.",
  "type": "object",
  "required": [
    "task_id",
    "source_archive",
    "created_at",
    "status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^EVO-([0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}|P-[0-9a-f]{64})$"
    },
    "source_archive": {
      "type": "object",
      "required": [
        "archive_id",
        "archive_path"
      ],
      "properties": {
        "archive_id": {
          "type": "string"
        },
        "archive_path": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "dead",
        "proposal_only",
        "blocked"
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "max_retries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "extracted": {
      "type": "object",
      "description": "Files written by the worker. Keyed by destination ({feedback, project, experiences, user}).",
      "properties": {
        "feedback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experiences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "user": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "description": "How the worker routed the items. Keys: user, feedback, project, experiences, dropped.",
      "properties": {
        "user": {
          "type": "integer"
        },
        "feedback": {
          "type": "integer"
        },
        "project": {
          "type": "integer"
        },
        "experiences": {
          "type": "integer"
        },
        "dropped": {
          "type": "integer"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "archive_learning_proposal"
      ]
    },
    "project_scope": {
      "type": "object",
      "required": [
        "project",
        "workspace_id"
      ],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^workspace-sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "observation_counts": {
      "type": "object",
      "required": [
        "reported_done",
        "planned_next",
        "reported_blockers",
        "reported_in_progress"
      ],
      "properties": {
        "reported_done": {
          "type": "integer",
          "minimum": 0
        },
        "planned_next": {
          "type": "integer",
          "minimum": 0
        },
        "reported_blockers": {
          "type": "integer",
          "minimum": 0
        },
        "reported_in_progress": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "execution_authorized": {
      "const": false
    },
    "allowed_effects": {
      "type": "array",
      "maxItems": 0
    },
    "schema_version": {
      "const": "1"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "archive_learning_proposal"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "schema_version",
          "project_scope",
          "observation_counts",
          "execution_authorized",
          "allowed_effects"
        ],
        "properties": {
          "task_id": {
            "pattern": "^EVO-P-[0-9a-f]{64}$"
          },
          "source_archive": {
            "required": [
              "sha256",
              "created_at"
            ]
          }
        }
      }
    }
  ]
}
