{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex-agent.local/schemas/guided-review-finding.schema.json",
  "title": "Cortex Agent Guided Review Finding",
  "description": "One reviewed concern. A reviewer backend produces findings; a guided-review artifact is a set of them. The field names are identical to the artifact's group definition, so a validated finding can be lifted into an artifact without renaming or reshaping.",
  "type": "object",
  "required": ["group_id", "title", "intent", "files", "summary", "impact", "risk", "validation_refs", "follow_ups"],
  "properties": {
    "group_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "intent": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "summary": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "category": { "type": "string", "enum": ["architecture", "quality", "test", "validation", "security", "performance", "docs"] },
    "validation_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "follow_ups": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
