{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex-agent.local/schemas/authorization.schema.json",
  "title": "Cortex Agent Authorization",
  "type": "object",
  "required": ["schema_version", "authorization_id", "decision_id", "decision_source", "policy", "reason", "scope", "validity", "child_inheritance", "consumed_operation_ids", "revoked_at", "expires_at", "created_at", "revision"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "authorization_id": { "type": "string", "pattern": "^AUTH-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "decision_id": { "type": "string", "pattern": "^D-[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "decision_source": { "type": "string" },
    "policy": { "type": "string" },
    "reason": { "type": "string" },
    "scope": { "type": "object" },
    "validity": { "type": "object" },
    "child_inheritance": { "type": "boolean" },
    "consumed_operation_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
