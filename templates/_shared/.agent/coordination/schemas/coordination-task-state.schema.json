{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex-agent.local/schemas/coordination-task-state.schema.json",
  "title": "Cortex Agent Coordination Task State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "taskId", "projectId", "state", "revision",
    "lastSequence", "producerSequences", "createdAt", "updatedAt",
    "ownership", "evidenceRefs", "pendingCriticalEvents"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "parentTaskId": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "state": {
      "enum": [
        "CREATED", "ASSIGNED", "ACCEPTED", "EXECUTING", "TESTING",
        "READY_FOR_REVIEW", "WAITING_FOR_INPUT", "BLOCKED", "FAILED",
        "CANCEL_REQUESTED", "CANCELLED", "TAKEOVER_REQUESTED",
        "TAKEN_OVER", "STALE", "COMPLETED"
      ]
    },
    "revision": { "type": "integer", "minimum": 1 },
    "lastSequence": { "type": "integer", "minimum": 0 },
    "producerSequences": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "heartbeatDueAt": { "type": ["string", "null"], "format": "date-time" },
    "lastHeartbeatAt": { "type": ["string", "null"], "format": "date-time" },
    "lastEventId": { "type": ["string", "null"] },
    "lastEventAt": { "type": ["string", "null"], "format": "date-time" },
    "assignee": { "type": ["string", "null"] },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leaseId", "scope", "owner", "fencingToken", "expiresAt"],
        "properties": {
          "leaseId": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "fencingToken": { "type": "integer", "minimum": 1 },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "progress": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "maxLength": 4000 }
      }
    },
    "requestedAction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["provide_input", "review", "approve", "stop", "release_ownership", "takeover"] },
        "ref": { "type": "string", "minLength": 1 },
        "decisionRef": { "type": "string", "minLength": 1 },
        "waitpointRef": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["kind"]
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "pendingCriticalEvents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "operationId": { "type": ["string", "null"] },
    "operationAttempt": { "type": ["integer", "null"], "minimum": 1 }
  }
}
