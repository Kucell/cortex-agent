{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cortex-agent.dev/schemas/evolution-task.schema.json",
  "title": "Evolution Task",
  "description": "Asynchronous self-evolution task. Created by `runtime-continuity` archive hook, consumed by evolution-worker. Inspired by OpenViking's session.commit() async memory extraction. Each task is one-shot (idempotent on re-run).",
  "type": "object",
  "required": ["task_id", "source_archive", "created_at", "status"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^EVO-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$" },
    "source_archive": {
      "type": "object",
      "required": ["archive_id", "archive_path"],
      "properties": {
        "archive_id": { "type": "string" },
        "archive_path": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "completed", "failed", "dead"]
    },
    "retry_count": { "type": "integer", "minimum": 0, "maximum": 10 },
    "max_retries": { "type": "integer", "minimum": 1, "maximum": 10 },
    "extracted": {
      "type": "object",
      "description": "Files written by the worker. Keyed by destination ({feedback, project, experiences, user}).",
      "properties": {
        "feedback": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "array", "items": { "type": "string" } },
        "experiences": { "type": "array", "items": { "type": "string" } },
        "user": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "description": "How the worker routed the items. Keys: user, feedback, project, experiences, dropped.",
      "properties": {
        "user": { "type": "integer" },
        "feedback": { "type": "integer" },
        "project": { "type": "integer" },
        "experiences": { "type": "integer" },
        "dropped": { "type": "integer" }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string" },
          "stage": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
